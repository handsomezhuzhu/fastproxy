# FastProxy 环境变量示例（复制为 .env，与 docker-compose.yml 同目录；.env 不要提交）
# compose 会自动读取本文件，并在启动时注入容器。

# 管理面板密码（必填）
ADMIN_PASSWORD=change-me

# 镜像标签：latest / edge / 1.0.0-rc.3 / v1.0.0-rc.3
# 生产建议固定版本号，避免 latest 漂移
# IMAGE_TAG=1.0.0-rc.3

# 面板会话签名密钥（可选；留空自动生成并保存在数据目录）
# SESSION_SECRET=

# 端口范围：应用只允许创建此范围内的端口，Docker 也映射同一范围
# 默认 10001-10050；宿主机端口紧张时改小，例如 10001-10020
# PORT_RANGE=10001-10050

# 数据密码加密密钥：32 字节 base64 或 64 位 hex
# 强烈建议设置；留空则自动生成 /data/.secret_key
# 注意：备份数据库时必须一并备份密钥，否则密码无法解密
# FASTPROXY_SECRET_KEY=

# 面板登录失败锁定（全局、仅内存，容器重启清零）
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_DURATION=5m

# 反向代理：可信代理 CIDR，逗号分隔
# Nginx/OpenResty 与 FastProxy 同机时：127.0.0.1/32
# 跨机时填反代服务器的内网网段
# TRUSTED_PROXIES=127.0.0.1/32

# 可选：上游凭据，可在上游地址里用 ${UPSTREAM_USER_1}/${UPSTREAM_PASS_1} 引用
# UPSTREAM_USER_1=myuser
# UPSTREAM_PASS_1=secret
