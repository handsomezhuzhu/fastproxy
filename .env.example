# FastProxy 环境变量示例（与 docker-compose.yml 同目录，请勿提交真实密钥）

# 管理密码（必填）：容器每次启动都会用该值重置密码哈希
ADMIN_PASSWORD=change-me

# 可选：会话签名密钥（固定值可让重启后会话不失效；留空自动生成）
# SESSION_SECRET=

# 可选：数据密码加密密钥（32 字节的 base64 标准/URL 或 64 位 hex）。
# 留空则在数据目录自动生成 /data/.secret_key（权限 0600）。
# 生成：python3 -c 'import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
# FASTPROXY_SECRET_KEY=

# 线路端口范围（启动级配置，默认 10001-10050）。
# Docker 发布端口必须与之一致，否则客户端连不上：
#   -p ${PORT_RANGE}:${PORT_RANGE}      （10001-10050 或单个 10080）
# 面板端口 7788 单独映射，不包含在 PORT_RANGE 内。
PORT_RANGE=10001-10050

# 面板登录全局失败锁定（单管理员，仅内存，重启清零）
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_DURATION=5m

# 可信反向代理 CIDR（逗号分隔）。只有这些来源的 X-Forwarded-For/Proto 才会被采信。
# 同机 Nginx/OpenResty：127.0.0.1/32；Docker 内网反代：例如 172.18.0.0/16
# TRUSTED_PROXIES=127.0.0.1/32

# 可选：上游/账户凭据引用，例如密码填 ${UPSTREAM_USER_1}/${UPSTREAM_PASS_1}
# UPSTREAM_USER_1=myuser
# UPSTREAM_PASS_1=secret
